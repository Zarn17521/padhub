diff --git a/apple/ios/src/touch_controls.cpp b/apple/ios/src/touch_controls.cpp
index d35d62a..d52d4b3 100644
--- a/apple/ios/src/touch_controls.cpp
+++ b/apple/ios/src/touch_controls.cpp
@@ -267,10 +267,11 @@ bool SDLCALL lifecycle_watch(void*, SDL_Event* e) {
 bool hold_guest(void*) { return g_pause_reasons.load() != 0; }
 
 // Runs once per presented frame on the main thread.
+bool g_shell_installed = false;  // per run: a host app (PadHub) may start the game again (bluewake_touch_controls_reset)
+
 void frame_tick(void*) {
-    static bool s_installed = false;
-    if (!s_installed) {
-        s_installed = true;
+    if (!g_shell_installed) {
+        g_shell_installed = true;
         SDL_AddEventWatch(lifecycle_watch, nullptr);
         bluewake_shell_install_overlay();
     }
@@ -329,6 +330,14 @@ extern "C" void bluewake_pause_set(unsigned reason, bool on) {
 
 extern "C" unsigned bluewake_pause_reasons(void) { return g_pause_reasons.load(); }
 
+// Before a host app (PadHub) starts the game again in the same process: SDL's
+// window and its event watches went with the last run.
+extern "C" void bluewake_touch_controls_reset(void) {
+    g_shell_installed = false;
+    g_pause_reasons.store(0);
+    bluewake_touch_clear();
+}
