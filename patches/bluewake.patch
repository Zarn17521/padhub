+++ b/apple/ios/CMakeLists.txt
@@ -208,3 +208,10 @@ set_source_files_properties(${BLUEWAKE_APP_ICONS} PROPERTIES MACOSX_PACKAGE_LOCA
 set(BLUEWAKE_PIPELINE_SEED "${CMAKE_CURRENT_SOURCE_DIR}/resources/initial_pipeline_cache.db")
 target_sources(BlueWake PRIVATE ${BLUEWAKE_PIPELINE_SEED})
 set_source_files_properties(${BLUEWAKE_PIPELINE_SEED} PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
+
+# PadHub (a host app that runs several games): -DBLUEWAKE_PADHUB=ON adds
+# BlueWakeGame.framework, defined in PadHub's checkout (PADHUB_DIR).
+option(BLUEWAKE_PADHUB "Build BlueWakeGame.framework for PadHub" OFF)
+if(BLUEWAKE_PADHUB)
+    include("${PADHUB_DIR}/Games/BlueWake/BlueWakeGame.cmake")
+endif()
