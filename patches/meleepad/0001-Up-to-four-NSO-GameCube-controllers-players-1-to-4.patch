+# NSOGC
+
+Vendored copy of NSOGCKit from
+[pookee/nso-gamecube-ios](https://github.com/pookee/nso-gamecube-ios)
+(`Sources/NSOGCKit`, with `include/` flattened) at commit `a6a82e8`: the Nintendo Switch Online
+GameCube controller made for the Switch 2 over Bluetooth LE. iOS has no driver
+for it, so the app connects it itself through CoreBluetooth.
+
+`MeleePadNSOGCBridge` makes up to four of them players 1 to 4. Update these
+files from that repository rather than editing them here.
diff --git a/apple/ios/NSOGC/nsogc_protocol.c b/apple/ios/NSOGC/nsogc_protocol.c
new file mode 100644
index 0000000..dfba0ed
--- /dev/null
+++ b/apple/ios/NSOGC/nsogc_protocol.c
@@ -0,0 +1,245 @@
+#include "nsogc_protocol.h"
+
+#include <math.h>
+#include <string.h>
+
+static uint16_t read_u16le(const uint8_t *p) {
+  return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+// Two 12-bit axes packed into three bytes: X in the low 12 bits.
+static void unpack_stick(const uint8_t *p, uint16_t *x, uint16_t *y) {
+  *x = (uint16_t)(p[0] | ((p[1] & 0x0F) << 8));
+  *y = (uint16_t)((p[1] >> 4) | (p[2] << 4));
+}
+
+// Reports in the Switch Pro layout carry the GameCube buttons at other bits.
+static uint32_t remap_pro_buttons(uint8_t b0, uint8_t b1, uint8_t b2) {
+  uint32_t buttons = 0;
+  if (b0 & 0x01) buttons |= NSOGC_BUTTON_Y;
+  if (b0 & 0x02) buttons |= NSOGC_BUTTON_X;
+  if (b0 & 0x04) buttons |= NSOGC_BUTTON_B;
+  if (b0 & 0x08) buttons |= NSOGC_BUTTON_A;
+  if (b0 & 0x10) buttons |= NSOGC_BUTTON_R;
+  if (b0 & 0x20) buttons |= NSOGC_BUTTON_Z;
+  if (b1 & 0x02) buttons |= NSOGC_BUTTON_START;
+  if (b1 & 0x10) buttons |= NSOGC_BUTTON_HOME;
+  if (b1 & 0x20) buttons |= NSOGC_BUTTON_CAPTURE;
+  if (b2 & 0x01) buttons |= NSOGC_BUTTON_DPAD_DOWN;
+  if (b2 & 0x02) buttons |= NSOGC_BUTTON_DPAD_UP;
+  if (b2 & 0x04) buttons |= NSOGC_BUTTON_DPAD_RIGHT;
+  if (b2 & 0x08) buttons |= NSOGC_BUTTON_DPAD_LEFT;
+  if (b2 & 0x40) buttons |= NSOGC_BUTTON_L;
+  if (b2 & 0x80) buttons |= NSOGC_BUTTON_ZL;
+  return buttons;
+}
+
+nsogc_report_format nsogc_parse_report(const uint8_t *data, size_t length,
+                                       nsogc_raw_input *out) {
+  if (out == NULL)
+    return NSOGC_REPORT_INVALID;
+  memset(out, 0, sizeof *out);
+  if (data == NULL || length < NSOGC_MIN_INPUT_REPORT_SIZE)
+    return NSOGC_REPORT_INVALID;
+
+  out->counter = data[0];
+  if (length == NSOGC_NATIVE_REPORT_SIZE) {
+    out->buttons = (uint32_t)data[2] | ((uint32_t)data[3] << 8) |
+                   ((uint32_t)(data[4] & 0x1F) << 16);
+    unpack_stick(data + 5, &out->stick_x, &out->stick_y);
+    unpack_stick(data + 8, &out->cstick_x, &out->cstick_y);
+    out->trigger_l = data[12];
+    out->trigger_r = data[13];
+    return NSOGC_REPORT_NATIVE;
+  }
+  if (data[0] == 0x30) {
+    out->buttons = remap_pro_buttons(data[3], data[4], data[5]);
+    unpack_stick(data + 6, &out->stick_x, &out->stick_y);
+    unpack_stick(data + 9, &out->cstick_x, &out->cstick_y);
+    out->trigger_l = data[14];
+    out->trigger_r = data[15];
+    return NSOGC_REPORT_PRO_FULL;
+  }
+  out->buttons = remap_pro_buttons(data[2], data[3], data[4]);
+  unpack_stick(data + 5, &out->stick_x, &out->stick_y);
+  unpack_stick(data + 8, &out->cstick_x, &out->cstick_y);
+  out->trigger_l = data[13];
+  out->trigger_r = data[14];
+  return NSOGC_REPORT_PRO_SHORT;
+}
+
+nsogc_report_format nsogc_parse_usb_report(const uint8_t *data, size_t length,
+                                           nsogc_raw_input *out) {
+  if (data != NULL && length == NSOGC_USB_REPORT_SIZE && data[0] == NSOGC_USB_REPORT_ID)
+    return nsogc_parse_report(data + 1, NSOGC_NATIVE_REPORT_SIZE, out);
+  return nsogc_parse_report(data, length, out);
+}
+
+void nsogc_calibration_default(nsogc_calibration *calibration) {
+  if (calibration == NULL)
+    return;
+  calibration->stick_center_x = 2048.0f;
+  calibration->stick_center_y = 2048.0f;
+  calibration->stick_range_x = 1220.0f;
+  calibration->stick_range_y = 1290.0f;
+  calibration->cstick_center_x = 2048.0f;
+  calibration->cstick_center_y = 2048.0f;
+  calibration->cstick_range_x = 1150.0f;
+  calibration->cstick_range_y = 1200.0f;
+  calibration->trigger_l_rest = 34.0f;
+  calibration->trigger_l_full = 230.0f;
+  calibration->trigger_r_rest = 34.0f;
+  calibration->trigger_r_full = 230.0f;
+  calibration->stick_deadzone = 0.05f;
+}
+
+static float clampf(float value, float low, float high) {
+  return value < low ? low : (value > high ? high : value);
+}
+
+// Radial dead zone, then the output is rescaled to start at 0 just past it
+// and kept inside the unit circle.
+static void normalize_stick(uint16_t raw_x, uint16_t raw_y, float center_x,
+                            float center_y, float range_x, float range_y,
+                            float deadzone, float *out_x, float *out_y) {
+  float x = ((float)raw_x - center_x) / fmaxf(range_x, 1.0f);
+  float y = ((float)raw_y - center_y) / fmaxf(range_y, 1.0f);
+  float magnitude = sqrtf(x * x + y * y);
+  deadzone = clampf(deadzone, 0.0f, 0.9f);
+  if (magnitude <= deadzone) {
+    *out_x = 0.0f;
+    *out_y = 0.0f;
+    return;
+  }
+  float scaled = (fminf(magnitude, 1.0f) - deadzone) / (1.0f - deadzone);
+  *out_x = clampf(x / magnitude * scaled, -1.0f, 1.0f);
+  *out_y = clampf(y / magnitude * scaled, -1.0f, 1.0f);
+}
+
+static float normalize_trigger(uint8_t raw, float rest, float full) {
+  float span = fmaxf(full - rest, 1.0f);
+  return clampf(((float)raw - rest) / span, 0.0f, 1.0f);
+}
+
+void nsogc_normalize(const nsogc_raw_input *raw,
+                     const nsogc_calibration *calibration, nsogc_state *out) {
+  if (out == NULL)
+    return;
+  memset(out, 0, sizeof *out);
+  if (raw == NULL)
+    return;
+  nsogc_calibration defaults;
+  if (calibration == NULL) {
+    nsogc_calibration_default(&defaults);
+    calibration = &defaults;
+  }
+  out->buttons = raw->buttons;
+  normalize_stick(raw->stick_x, raw->stick_y, calibration->stick_center_x,
+                  calibration->stick_center_y, calibration->stick_range_x,
+                  calibration->stick_range_y, calibration->stick_deadzone,
+                  &out->stick_x, &out->stick_y);
+  normalize_stick(raw->cstick_x, raw->cstick_y, calibration->cstick_center_x,
+                  calibration->cstick_center_y, calibration->cstick_range_x,
+                  calibration->cstick_range_y, calibration->stick_deadzone,
+                  &out->cstick_x, &out->cstick_y);
+  out->trigger_l = normalize_trigger(raw->trigger_l, calibration->trigger_l_rest,
+                                     calibration->trigger_l_full);
+  out->trigger_r = normalize_trigger(raw->trigger_r, calibration->trigger_r_rest,
+                                     calibration->trigger_r_full);
+}
+
+// Every command starts with its ID, the request type 0x91, the interface
+// (0x01 for Bluetooth), a sub-command, 0x00, the payload length and 0x0000.
+static size_t command_header(uint8_t *out, uint8_t command, uint8_t interface,
+                             uint8_t subcommand, uint8_t payload_length) {
+  out[0] = command;
+  out[1] = 0x91;
+  out[2] = interface;
+  out[3] = subcommand;
+  out[4] = 0x00;
+  out[5] = payload_length;
+  out[6] = 0x00;
+  out[7] = 0x00;
+  return 8;
+}
+
+size_t nsogc_command_spi_read(uint8_t out[16], uint32_t address, uint8_t size) {
+  size_t n = command_header(out, 0x02, 0x01, 0x04, 0x08);
+  out[n++] = size;
+  out[n++] = 0x7E;
+  out[n++] = 0x00;
+  out[n++] = 0x00;
+  out[n++] = (uint8_t)(address & 0xFF);
+  out[n++] = (uint8_t)((address >> 8) & 0xFF);
+  out[n++] = (uint8_t)((address >> 16) & 0xFF);
+  out[n++] = (uint8_t)((address >> 24) & 0xFF);
+  return n;
+}
+
+size_t nsogc_command_player_leds(uint8_t out[16], uint8_t mask) {
+  size_t n = command_header(out, 0x09, 0x01, 0x07, 0x08);
+  memset(out + n, 0, 8);
+  out[n] = mask;
+  return n + 8;
+}
+
+size_t nsogc_command_vibration(uint8_t out[12], bool on) {
+  size_t n = command_header(out, 0x0A, 0x01, 0x02, 0x04);
+  memset(out + n, 0, 4);
+  out[n] = on ? 0x01 : 0x00;
+  return n + 4;
+}
+
+size_t nsogc_command_default_report(uint8_t out[16]) {
+  size_t n = command_header(out, 0x03, 0x00, 0x0D, 0x08);
+  out[n++] = 0x01;
+  out[n++] = 0x00;
+  memset(out + n, 0xFF, 6);
+  return n + 6;
+}
+
+void nsogc_command_for_usb(uint8_t *frame, size_t length) {
+  if (frame != NULL && length > 2)
+    frame[2] = 0x00;
+}
+
+uint8_t nsogc_player_led_mask(int player) {
+  static const uint8_t masks[4] = {0x01, 0x03, 0x07, 0x0F};
+  if (player < 0)
+    player = 0;
+  if (player > 3)
+    player = 3;
+  return masks[player];
+}
+
+bool nsogc_find_vendor_product(const uint8_t *data, size_t length,
+                               uint16_t *product_id) {
+  if (data == NULL)
+    return false;
+  for (size_t i = 0; i + 3 < length; i++) {
+    if (read_u16le(data + i) == NSOGC_VENDOR_ID) {
+      if (product_id != NULL)
+        *product_id = read_u16le(data + i + 2);
+      return true;
+    }
+  }
+  return false;
+}
+
+bool nsogc_advertisement_matches(const uint8_t *data, size_t length,
+                                 uint16_t *product_id) {
+  if (product_id != NULL)
+    *product_id = 0;
+  if (data == NULL || length < 2)
+    return false;
+  uint16_t company = read_u16le(data);
+  if (company != NSOGC_COMPANY_ID_SWITCH2 && company != NSOGC_COMPANY_ID_CLASSIC)
+    return false;
+  uint16_t product = 0;
+  if (nsogc_find_vendor_product(data + 2, length - 2, &product)) {
+    if (product_id != NULL)
+      *product_id = product;
+    return product == NSOGC_PRODUCT_ID;
+  }
+  return true;
+}
diff --git a/apple/ios/NSOGC/nsogc_protocol.h b/apple/ios/NSOGC/nsogc_protocol.h
new file mode 100644
index 0000000..7bc826a
--- /dev/null
+++ b/apple/ios/NSOGC/nsogc_protocol.h
@@ -0,0 +1,143 @@
+// Protocol layer for the Nintendo Switch Online GameCube controller made for
+// the Switch 2 (vendor 0x057E, product 0x2073) over Bluetooth LE: input report
+// decoding, stick and trigger normalization, command frames and advertisement
+// matching. Plain C with no platform dependency, so it can be unit tested on
+// any host and shared by Objective-C, C++ and Swift code.
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define NSOGC_VENDOR_ID 0x057E
+#define NSOGC_PRODUCT_ID 0x2073
+
+// Bluetooth SIG company identifiers Nintendo advertises with: 0x0553 on the
+// Switch 2 controllers, 0x037E on older ones.
+#define NSOGC_COMPANY_ID_SWITCH2 0x0553
+#define NSOGC_COMPANY_ID_CLASSIC 0x037E
+
+// Length of the controller's native input report.
+#define NSOGC_NATIVE_REPORT_SIZE 63
+
+// Shorter notifications are command responses, never input.
+#define NSOGC_MIN_INPUT_REPORT_SIZE 30
+
+// Buttons, in GameCube terms. Bits 0-7, 8-15 and 16-23 are bytes 2, 3 and 4
+// of the native report, so a native report is used without remapping.
+typedef enum {
+  NSOGC_BUTTON_B = 1u << 0,
+  NSOGC_BUTTON_A = 1u << 1,
+  NSOGC_BUTTON_Y = 1u << 2,
+  NSOGC_BUTTON_X = 1u << 3,
+  NSOGC_BUTTON_R = 1u << 4,      // digital click at the end of the R trigger
+  NSOGC_BUTTON_Z = 1u << 5,
+  NSOGC_BUTTON_START = 1u << 6,
+  NSOGC_BUTTON_DPAD_DOWN = 1u << 8,
+  NSOGC_BUTTON_DPAD_RIGHT = 1u << 9,
+  NSOGC_BUTTON_DPAD_LEFT = 1u << 10,
+  NSOGC_BUTTON_DPAD_UP = 1u << 11,
+  NSOGC_BUTTON_L = 1u << 12,     // digital click at the end of the L trigger
+  NSOGC_BUTTON_ZL = 1u << 13,
+  NSOGC_BUTTON_HOME = 1u << 16,
+  NSOGC_BUTTON_CAPTURE = 1u << 17,
+  NSOGC_BUTTON_GR = 1u << 18,
+  NSOGC_BUTTON_GL = 1u << 19,
+  NSOGC_BUTTON_CHAT = 1u << 20,
+} nsogc_button;
+
+// Values as the controller sends them.
+typedef struct {
+  uint8_t counter;              // increments with every report
+  uint32_t buttons;             // nsogc_button bits
+  uint16_t stick_x, stick_y;    // 12-bit, centre about 2048, right and up are larger
+  uint16_t cstick_x, cstick_y;  // same for the C-stick
+  uint8_t trigger_l, trigger_r; // analog, about 34 at rest and 235 fully pressed
+} nsogc_raw_input;
+
+typedef enum {
+  NSOGC_REPORT_INVALID = 0,
+  NSOGC_REPORT_NATIVE,     // 63 bytes, GameCube button order
+  NSOGC_REPORT_PRO_FULL,   // starts with report ID 0x30, Switch Pro button order
+  NSOGC_REPORT_PRO_SHORT,  // Switch Pro button order without the report ID
+} nsogc_report_format;
+
+// Decodes one input notification. Returns NSOGC_REPORT_INVALID, and leaves
+// *out zeroed, when the data is not an input report.
+nsogc_report_format nsogc_parse_report(const uint8_t *data, size_t length,
+                                       nsogc_raw_input *out);
+
+// Over USB the controller is a HID gamepad. Once initialized (two commands
+// on interface 1's bulk OUT endpoint) it sends 64-byte input reports with
+// report ID 0x0A, followed by the native report.
+#define NSOGC_USB_REPORT_ID 0x0A
+#define NSOGC_USB_REPORT_SIZE 64
+#define NSOGC_USB_COMMAND_INTERFACE 1
+
+// Decodes one USB input report, with or without its leading report ID.
+nsogc_report_format nsogc_parse_usb_report(const uint8_t *data, size_t length,
+                                           nsogc_raw_input *out);
+
+typedef struct {
+  float stick_center_x, stick_center_y, stick_range_x, stick_range_y;
+  float cstick_center_x, cstick_center_y, cstick_range_x, cstick_range_y;
+  float trigger_l_rest, trigger_l_full, trigger_r_rest, trigger_r_full;
+  float stick_deadzone;  // radial, as a fraction of the range
+} nsogc_calibration;
+
+// Ranges measured on this controller by the NSO GameCube Controller Pairing
+// App (centre 2048, stick ranges 1150-1290, triggers 34 to about 235).
+void nsogc_calibration_default(nsogc_calibration *calibration);
+
+// Normalized input, ready for a game.
+typedef struct {
+  uint32_t buttons;           // nsogc_button bits
+  float stick_x, stick_y;     // -1...1, right and up positive, inside the unit circle
+  float cstick_x, cstick_y;
+  float trigger_l, trigger_r; // 0...1
+} nsogc_state;
+
+void nsogc_normalize(const nsogc_raw_input *raw,
+                     const nsogc_calibration *calibration, nsogc_state *out);
+
+// Command frames. Each writes the frame into out (sized as noted) and returns
+// its length. Over Bluetooth they go to the command characteristic; over USB
+// to interface 1's bulk OUT endpoint, after nsogc_command_for_usb.
+#define NSOGC_COMMAND_MAX_SIZE 16
+
+size_t nsogc_command_spi_read(uint8_t out[16], uint32_t address, uint8_t size);
+size_t nsogc_command_player_leds(uint8_t out[16], uint8_t mask);
+size_t nsogc_command_vibration(uint8_t out[12], bool on);
+size_t nsogc_command_default_report(uint8_t out[16]);
+
+// Byte 2 of a command names the interface it travels on: 0x01 over
+// Bluetooth, as the builders write it, 0x00 over USB. This rewrites it.
+void nsogc_command_for_usb(uint8_t *frame, size_t length);
+
+// SPI flash address of the device information block (serial number, vendor
+// and product ID).
+#define NSOGC_SPI_DEVICE_INFO 0x00013000u
+
+// Player LED mask for a 0-based player index: 1, 2, 3 or 4 LEDs lit.
+uint8_t nsogc_player_led_mask(int player);
+
+// Matches a Bluetooth advertisement's manufacturer data (company ID first,
+// little-endian). Writes the advertised product ID, or 0 when the data has
+// none, to *product_id. True for the GameCube controller, and for Nintendo
+// data without a product ID (the device information read confirms it).
+bool nsogc_advertisement_matches(const uint8_t *data, size_t length,
+                                 uint16_t *product_id);
+
+// Looks for Nintendo's vendor ID followed by a product ID, as in the device
+// information block. True when found.
+bool nsogc_find_vendor_product(const uint8_t *data, size_t length,
+                               uint16_t *product_id);
+
+#ifdef __cplusplus
+}
+#endif
