diff --git a/apple/ios/MeleePadNSOGCBridge.h b/apple/ios/MeleePadNSOGCBridge.h
new file mode 100644
index 0000000..7547fa6
--- /dev/null
+++ b/apple/ios/MeleePadNSOGCBridge.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#import <Foundation/Foundation.h>
+
+#include "MeleePadInputState.h"
+
+NS_ASSUME_NONNULL_BEGIN
+
+typedef NS_ENUM(NSInteger, MeleePadNSOGCStatus) {
+    MeleePadNSOGCStatusOff,          // turned off from the Controls menu
+    MeleePadNSOGCStatusUnavailable,  // Bluetooth is off or not allowed for MeleePad
+    MeleePadNSOGCStatusSearching,    // none connected yet: waiting for one in SYNC mode
+    MeleePadNSOGCStatusConnected,    // one or more connected (and looking for more)
+};
+
+/* Connects up to four Nintendo Switch Online GameCube controllers made for the
+ * Switch 2, which iOS has no driver for, over Bluetooth LE through NSOGCKit
+ * (NSOGC/). The first is player one, like a GameController pad; the others
+ * are players 2 to 4, each plugged into its own GameCube port while it is
+ * connected. Main thread only, except where noted. */
+@interface MeleePadNSOGCBridge : NSObject
+
++ (instancetype)sharedBridge;
+
+/* Starts Bluetooth unless the controllers were turned off from the Controls
+ * menu. The first start shows the Bluetooth permission prompt. */
+- (void)start;
+
+/* Turns the controllers on: reconnects remembered ones and looks for one in
+ * SYNC mode. The choice is kept across launches. */
+- (void)connect;
+
+/* Disconnects every controller and stays off until connect. */
+- (void)disconnect;
+
+/* Forgets remembered controllers and disconnects them; controllers in SYNC
+ * mode can then pair. */
+- (void)forgetControllers;
+
+@property(nonatomic, readonly) MeleePadNSOGCStatus status;
+@property(nonatomic, readonly) BOOL playerOneConnected;
+@property(nonatomic, readonly) NSUInteger connectedCount;
+@property(nonatomic, readonly) BOOL hasRememberedControllers;
+
+/* "Player 1: name", one per connected controller, in player order. */
+@property(nonatomic, readonly) NSArray<NSString *> *connectedDescriptions;
+
+/* Called when a controller connects or disconnects, or the controllers are
+ * turned on or off. */
+@property(nonatomic, copy, nullable) void (^connectionChangedHandler)(void);
+
+/* Bluetooth queue: player one's report just reached the input mixer, so the
+ * game can be fed without waiting for the next tick. Set it before start. */
+@property(nonatomic, copy, nullable) void (^playerOneInputHandler)(void);
+
+/* Bluetooth queue: input for players 2-4 (GameCube ports 1-3). Set it before
+ * start. */
+@property(nonatomic, copy, nullable) void (^portInputHandler)(NSInteger port, MeleePadInputState state);
+
+/* Players 2-4's controllers connecting and disconnecting (ports 1-3). */
+@property(nonatomic, copy, nullable) void (^portConnectionHandler)(NSInteger port, BOOL connected);
+
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/apple/ios/MeleePadNSOGCBridge.mm b/apple/ios/MeleePadNSOGCBridge.mm
new file mode 100644
index 0000000..88c84ad
--- /dev/null
+++ b/apple/ios/MeleePadNSOGCBridge.mm
@@ -0,0 +1,218 @@
+#import "MeleePadNSOGCBridge.h"
+
+#import "NSOGC/NSOGCKit.h"
+#import "MeleePadDiagnostics.h"
+#import "MeleePadInputMixer.h"
+
+#include <cmath>
+
+static NSString *const kEnabledKey = @"MeleePadNSOGCEnabled";
+
+// The controller is a GameCube pad, so its buttons map one to one; the
+// player's face-button mapping is for other layouts. L and R are the
+// triggers' own end-of-travel clicks, as on the original controller.
+static MeleePadInputState MeleePadInputStateFromNSOGC(const nsogc_state &pad) {
+    static const struct {
+        uint32_t pad;
+        uint16_t meleepad;
+    } kButtons[] = {
+        {NSOGC_BUTTON_A, MeleePadButtonA},
+        {NSOGC_BUTTON_B, MeleePadButtonB},
+        {NSOGC_BUTTON_X, MeleePadButtonX},
+        {NSOGC_BUTTON_Y, MeleePadButtonY},
+        {NSOGC_BUTTON_Z, MeleePadButtonZ},
+        {NSOGC_BUTTON_START, MeleePadButtonStart},
+        {NSOGC_BUTTON_L, MeleePadButtonL},
+        {NSOGC_BUTTON_R, MeleePadButtonR},
+        {NSOGC_BUTTON_DPAD_UP, MeleePadButtonDpadUp},
+        {NSOGC_BUTTON_DPAD_DOWN, MeleePadButtonDpadDown},
+        {NSOGC_BUTTON_DPAD_LEFT, MeleePadButtonDpadLeft},
+        {NSOGC_BUTTON_DPAD_RIGHT, MeleePadButtonDpadRight},
+    };
+    MeleePadInputState state = {};
+    state.connected = 1;
+    for (const auto &button : kButtons) {
+        if (pad.buttons & button.pad)
+            state.buttons |= button.meleepad;
+    }
+    state.stickX = (int8_t)std::lround(pad.stick_x * 127.0f);
+    state.stickY = (int8_t)std::lround(pad.stick_y * 127.0f);
+    state.cStickX = (int8_t)std::lround(pad.cstick_x * 127.0f);
+    state.cStickY = (int8_t)std::lround(pad.cstick_y * 127.0f);
+    state.triggerL = (uint8_t)std::lround(pad.trigger_l * 255.0f);
+    state.triggerR = (uint8_t)std::lround(pad.trigger_r * 255.0f);
+    return state;
+}
+
+@interface MeleePadNSOGCBridge () <NSOGCManagerDelegate>
+@end
+
+@implementation MeleePadNSOGCBridge {
+    NSMutableDictionary<NSNumber *, NSOGCController *> *_controllers;  // by player index
+    BOOL _configured;
+    BOOL _bluetoothAvailable;
+}
+
++ (instancetype)sharedBridge {
+    static MeleePadNSOGCBridge *bridge;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        bridge = [[MeleePadNSOGCBridge alloc] init];
+    });
+    return bridge;
+}
+
+- (instancetype)init {
+    if ((self = [super init])) {
+        [NSUserDefaults.standardUserDefaults registerDefaults:@{kEnabledKey : @YES}];
+        _controllers = [NSMutableDictionary dictionary];
+        _bluetoothAvailable = YES;
+    }
+    return self;
+}
+
+- (BOOL)enabled {
+    return [NSUserDefaults.standardUserDefaults boolForKey:kEnabledKey];
+}
+
+- (void)setEnabled:(BOOL)enabled {
+    [NSUserDefaults.standardUserDefaults setBool:enabled forKey:kEnabledKey];
+}
+
+- (void)start {
+    if (self.enabled)
+        [self startManager];
+}
+
+- (void)startManager {
+    NSOGCManager *manager = NSOGCManager.sharedManager;
+    if (!_configured) {
+        _configured = YES;
+        manager.maximumControllers = 4;  // the GameCube's four ports
+        // Input goes straight from the Bluetooth queue into the locked mixer
+        // and players 2-4's pipes.
+        manager.deliversInputOnBluetoothQueue = YES;
+        manager.delegate = self;
+        manager.logHandler = ^(NSString *line) {
+            MeleePadLog(@"nsogc %@", line);
+        };
+    }
+    [manager start];
+}
+
+- (void)connect {
+    self.enabled = YES;
+    [self startManager];
+    MeleePadLog(@"nsogc turned on");
+    [self notifyConnectionChanged];
+}
+
+- (void)disconnect {
+    self.enabled = NO;
+    [NSOGCManager.sharedManager stop];
+    MeleePadLog(@"nsogc turned off");
+    [self notifyConnectionChanged];
+}
+
+- (void)forgetControllers {
+    NSOGCManager *manager = NSOGCManager.sharedManager;
+    [manager forgetControllers];
+    // Forgotten first, so the disconnections do not wait for them to come back.
+    for (NSOGCController *controller in _controllers.allValues)
+        [manager disconnectController:controller];
+    MeleePadLog(@"nsogc controllers forgotten");
+    [self notifyConnectionChanged];
+}
+
+- (MeleePadNSOGCStatus)status {
+    if (!self.enabled)
+        return MeleePadNSOGCStatusOff;
+    if (_controllers.count > 0)
+        return MeleePadNSOGCStatusConnected;
+    if (!_bluetoothAvailable)
+        return MeleePadNSOGCStatusUnavailable;
+    return MeleePadNSOGCStatusSearching;
+}
+
+- (BOOL)playerOneConnected {
+    return _controllers[@0] != nil;
+}
+
+- (NSUInteger)connectedCount {
+    return _controllers.count;
+}
+
+- (BOOL)hasRememberedControllers {
+    return NSOGCManager.sharedManager.hasRememberedControllers;
+}
+
+- (NSArray<NSString *> *)connectedDescriptions {
+    NSMutableArray<NSString *> *descriptions = [NSMutableArray array];
+    for (NSInteger player = 0; player < 4; player++) {
+        NSOGCController *controller = _controllers[@(player)];
+        if (controller != nil)
+            [descriptions addObject:[NSString stringWithFormat:@"Player %ld: %@", (long)player + 1,
+                                                               controller.name]];
+    }
+    return descriptions;
+}
+
+- (void)notifyConnectionChanged {
+    if (self.connectionChangedHandler != nil)
+        self.connectionChangedHandler();
+}
+
+#pragma mark - NSOGCManagerDelegate (main thread)
+
+- (void)manager:(NSOGCManager *)manager didConnectController:(NSOGCController *)controller {
+    NSInteger player = controller.playerIndex;
+    if (player < 0 || player > 3 || _controllers[@(player)] != nil)
+        return;
+    _controllers[@(player)] = controller;
+    if (player == 0) {
+        void (^inputUpdated)(void) = self.playerOneInputHandler;
+        // Runs on the Bluetooth queue for every report.
+        controller.inputHandler = ^(NSOGCController *source, nsogc_state state) {
+            (void)source;
+            [[MeleePadInputMixer sharedMixer] setInputState:MeleePadInputStateFromNSOGC(state)
+                                                  fromTouch:NO];
+            if (inputUpdated != nil)
+                inputUpdated();
+        };
+    } else {
+        void (^portInput)(NSInteger, MeleePadInputState) = self.portInputHandler;
+        controller.inputHandler = ^(NSOGCController *source, nsogc_state state) {
+            (void)source;
+            if (portInput != nil)
+                portInput(player, MeleePadInputStateFromNSOGC(state));
+        };
+        if (self.portConnectionHandler != nil)
+            self.portConnectionHandler(player, YES);
+    }
+    MeleePadLog(@"nsogc controller connected player=%ld name=%@", (long)player + 1, controller.name);
+    [self notifyConnectionChanged];
+}
+
+- (void)manager:(NSOGCManager *)manager didDisconnectController:(NSOGCController *)controller {
+    NSInteger player = controller.playerIndex;
+    if (_controllers[@(player)] != controller)
+        return;
+    controller.inputHandler = nil;
+    [_controllers removeObjectForKey:@(player)];
+    // NSOGCKit already delivered a neutral state on the Bluetooth queue, which
+    // stays the only writer of players 2-4's pipes.
+    if (player == 0) {
+        [[MeleePadInputMixer sharedMixer] clearInputFromTouch:NO];
+    } else if (self.portConnectionHandler != nil) {
+        self.portConnectionHandler(player, NO);
+    }
+    MeleePadLog(@"nsogc controller disconnected player=%ld", (long)player + 1);
+    [self notifyConnectionChanged];
+}
+
+- (void)manager:(NSOGCManager *)manager bluetoothAvailabilityDidChange:(BOOL)available {
+    _bluetoothAvailable = available;
+    [self notifyConnectionChanged];
+}
+
+@end
diff --git a/apple/ios/NSOGC/NSOGCController.h b/apple/ios/NSOGC/NSOGCController.h
new file mode 100644
index 0000000..c0b67f2
--- /dev/null
+++ b/apple/ios/NSOGC/NSOGCController.h
@@ -0,0 +1,55 @@
+#import <Foundation/Foundation.h>
+
+#include "nsogc_protocol.h"
+
+NS_ASSUME_NONNULL_BEGIN
+
+typedef NS_ENUM(NSInteger, NSOGCControllerStatus) {
+  NSOGCControllerStatusConnecting,
+  NSOGCControllerStatusInitializing,
+  NSOGCControllerStatusReady,
+  NSOGCControllerStatusDisconnected,
+};
+
+@class NSOGCController;
+
+typedef void (^NSOGCInputHandler)(NSOGCController *controller, nsogc_state state);
+
+// One NSO GameCube controller. NSOGCManager creates them; an app only reads
+// their state or sets an input handler.
+@interface NSOGCController : NSObject
+
+// Stable per device on this phone (CoreBluetooth's peripheral identifier).
+@property(nonatomic, readonly) NSUUID *identifier;
+@property(nonatomic, readonly, copy) NSString *name;
+@property(nonatomic, readonly) NSOGCControllerStatus status;
+
+// 0-based player, shown on the controller's LEDs.
+@property(nonatomic, readonly) NSInteger playerIndex;
+
+// Connected with a USB cable (macOS) rather than over Bluetooth.
+@property(nonatomic, readonly, getter=isWired) BOOL wired;
+
+// Latest input, normalized and as received. Safe to read from any thread.
+@property(nonatomic, readonly) nsogc_state state;
+@property(nonatomic, readonly) nsogc_raw_input rawInput;
+
+// Starts as nsogc_calibration_default with the stick centres taken from the
+// first reports at rest.
+@property(nonatomic) nsogc_calibration calibration;
+
+// Called on the manager's callbackQueue with every new report. Reports that
+// arrive while an earlier one is still queued replace it, so a busy main
+// thread only ever gets the latest state. With the manager's
+// deliversInputOnBluetoothQueue, called on the Bluetooth queue for every
+// report instead.
+@property(nonatomic, copy, nullable) NSOGCInputHandler inputHandler;
+
+- (void)setRumble:(BOOL)on;
+
+- (instancetype)init NS_UNAVAILABLE;
++ (instancetype)new NS_UNAVAILABLE;
+
+@end
+
+NS_ASSUME_NONNULL_END
