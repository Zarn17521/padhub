+// A host app may have used the manager while MeleePad was behind its menu:
+// catch up with the controllers that came and went, and give the others their
+// handlers back without unplugging their ports.
+- (void)adoptControllersOfManager:(NSOGCManager *)manager {
+    NSArray<NSOGCController *> *ready = manager.controllers;
+    for (NSNumber *player in _controllers.allKeys) {
+        NSOGCController *controller = _controllers[player];
+        if (![ready containsObject:controller] || controller.playerIndex != player.integerValue)
+            [self releasePlayer:player.integerValue];
+    }
+    for (NSOGCController *controller in ready) {
+        NSInteger player = controller.playerIndex;
+        if (_controllers[@(player)] == controller)
+            [self installInputHandlerOn:controller player:player];
+        else
+            [self manager:manager didConnectController:controller];
+    }
+}
+
+// Runs on the Bluetooth queue for every report.
+- (void)installInputHandlerOn:(NSOGCController *)controller player:(NSInteger)player {
+    __weak MeleePadNSOGCBridge *weakSelf = self;
+    __block uint32_t previousButtons = 0;
+    void (^watchHome)(nsogc_state) = ^(nsogc_state state) {
+        uint32_t pressed = state.buttons & ~previousButtons;
+        previousButtons = state.buttons;
+        if (pressed & NSOGC_BUTTON_HOME)
+            [weakSelf homeButtonPressed];
+    };
+    if (player == 0) {
+        void (^inputUpdated)(void) = self.playerOneInputHandler;
+        controller.inputHandler = ^(NSOGCController *source, nsogc_state state) {
+            (void)source;
+            [[MeleePadInputMixer sharedMixer] setInputState:MeleePadInputStateFromNSOGC(state)
+                                                  fromTouch:NO];
+            if (inputUpdated != nil)
+                inputUpdated();
+            watchHome(state);
+        };
+    } else {
+        void (^portInput)(NSInteger, MeleePadInputState) = self.portInputHandler;
+        controller.inputHandler = ^(NSOGCController *source, nsogc_state state) {
+            (void)source;
+            if (portInput != nil)
+                portInput(player, MeleePadInputStateFromNSOGC(state));
+            watchHome(state);
+        };
+    }
+}
+
+// Any queue.
+- (void)homeButtonPressed {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (self.homeButtonHandler != nil)
+            self.homeButtonHandler();
+    });
+}
+
+- (void)releasePlayer:(NSInteger)player {
+    NSOGCController *controller = _controllers[@(player)];
+    if (controller == nil)
+        return;
+    controller.inputHandler = nil;
+    [_controllers removeObjectForKey:@(player)];
+    // NSOGCKit already delivered a neutral state on the Bluetooth queue, which
+    // stays the only writer of players 2-4's pipes.
+    if (player == 0) {
+        [[MeleePadInputMixer sharedMixer] clearInputFromTouch:NO];
+    } else if (self.portConnectionHandler != nil) {
+        self.portConnectionHandler(player, NO);
+    }
+    MeleePadLog(@"nsogc controller disconnected player=%ld", (long)player + 1);
+    [self notifyConnectionChanged];
+}
+
